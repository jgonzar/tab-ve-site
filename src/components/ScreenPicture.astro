---
// One app screen inside the phone frame: AVIF and WebP at 1x to 3x of the
// width it's shown at, with explicit dimensions so nothing shifts. The hero
// loads first and eagerly; the others are lazy.
import { Picture } from "astro:assets";
import PhoneFrame from "./PhoneFrame.astro";
import { screen, type Screen } from "../captures";
import type { Locale } from "../i18n";

interface Props {
  locale: Locale;
  name: Screen;
  alt: string;
  /** The largest width the phone's screen is shown at, in CSS pixels */
  width: number;
  /** The `sizes` attribute for the layout it sits in */
  sizes: string;
  priority?: boolean;
}

const { locale, name, alt, width, sizes, priority = false } = Astro.props;
const image = screen(locale, name);
const height = Math.round((width * image.height) / image.width);
---

<PhoneFrame>
  <Picture
    src={image}
    alt={alt}
    formats={["avif", "webp"]}
    fallbackFormat="webp"
    width={width}
    height={height}
    widths={[width, width * 2, width * 3].filter((w) => w <= image.width)}
    sizes={sizes}
    quality={70}
    loading={priority ? "eager" : "lazy"}
    decoding={priority ? "sync" : "async"}
    fetchpriority={priority ? "high" : "auto"}
  />
</PhoneFrame>
