---
// "Settle up": the real shared receipt from the demo, as text in the phone
// frame (user, 2026-11-02), styled like a plain message someone sent. It's
// real text, so screen readers read it; the rules drawn with box characters
// are hidden from them. The visible caption (copy row 15) names it.
import PhoneFrame from "./PhoneFrame.astro";
import { receipt } from "../captures";
import type { Locale } from "../i18n";

interface Props {
  locale: Locale;
  caption: string;
}

const { locale, caption } = Astro.props;
// Built as one string, so no template formatting can add whitespace inside
// the <pre>. Every line is escaped; the rules are wrapped to hide them.
const escape = (text: string) =>
  text.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;");
const html = receipt(locale)
  .map((line) =>
    line.rule ? `<span aria-hidden="true">${escape(line.text)}</span>` : escape(line.text),
  )
  .join("\n");
---

<figure class="receipt">
  <PhoneFrame>
    <div class="receipt__screen">
      <div class="receipt__bubble">
        <pre class="receipt__text" set:html={html} />
      </div>
    </div>
  </PhoneFrame>
  <figcaption class="receipt__caption">{caption}</figcaption>
</figure>

<style>
  .receipt {
    margin: 0;
  }

  /* The phone's screen: the page colour, the message in the middle */
  .receipt__screen {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
    padding: 0 5cqi;
    text-align: left;
  }

  .receipt__bubble {
    padding: 4cqi;
    border-radius: 5cqi 5cqi 5cqi 1.5cqi;
    background: var(--tab-raised);
  }

  /* Sized to the screen, so the longest line (50 characters, about 30.1em
     in Menlo, the widest face in the stack) fits the bubble's 82% of the
     screen width without wrapping, at any phone width: 82 / 30.1 = 2.72 */
  .receipt__text {
    margin: 0;
    color: var(--tab-text);
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, "Liberation Mono", monospace;
    font-size: 2.7cqi;
    line-height: 1.4;
    white-space: pre;
    overflow: hidden;
  }

  .receipt__caption {
    margin-top: 0.75rem;
    color: var(--tab-text-muted);
    font-size: 0.875rem;
    text-align: center;
  }
</style>
