---
// The ES / EN switch: two plain links, so it works with JS off. With JS on,
// src/scripts/lang-cookie.ts saves the choice in a cookie on click, and the
// `/` redirect in vercel.json reads it on the next visit. Each link names its
// language in that language (copy row 4), with lang and hreflang to match.
// They end in #top (the body's id): that marks a switch, and the entry loader
// stays away for it, in CSS alone.
import { LOCALES, strings, type Locale } from "../i18n";
import { pagePath, type Page } from "../seo";

interface Props {
  locale: Locale;
  /** The page to switch, so each link leads to the same page in its language */
  page?: Page;
}

const { locale, page = "home" } = Astro.props;
const t = strings(locale);
---

<ul class="lang-links">
  {LOCALES.map((l) => (
    <li>
      <a
        class="lang-links__link"
        href={`${pagePath(l, page)}#top`}
        hreflang={l}
        lang={l}
        data-lang={l}
        aria-current={l === locale ? "page" : undefined}
      >
        <span aria-hidden="true">{t.lang[l].short}</span>
        <span class="sr-only">{t.lang[l].name}</span>
      </a>
    </li>
  ))}
</ul>

<script src="../scripts/lang-cookie.ts"></script>

<style>
  .lang-links {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lang-links__link {
    display: inline-grid;
    place-items: center;
    min-width: var(--tap-min);
    min-height: var(--tap-min);
    padding: 0 0.5rem;
    border-radius: 10px;
    color: var(--dim);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .lang-links__link:hover {
    color: var(--ink);
  }

  .lang-links__link[aria-current="page"] {
    color: var(--ink);
    box-shadow: inset 0 0 0 2px var(--ink);
  }
</style>
