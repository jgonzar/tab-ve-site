---
/*
 * A generic phone, drawn once in CSS around a raw capture (critique D5): a
 * rounded body and an even bezel, with no notch, buttons or any real
 * device's look. The captures in src/assets/captures/ are bare screens, so
 * the frame stays sharp at every size and isn't repeated in each bitmap.
 *
 * Usage (L4): put the screen's <picture> (or <Picture />) in the slot. The
 * frame takes the width its parent gives it. The outer element is a size
 * container, so the bezel and radii (in cqi, a percentage of its width)
 * scale with it. The screen keeps the captures' 390:844 shape. The frame is
 * decorative; the image carries the alt text.
 */
---

<div class="phone">
  <div class="phone__body">
    <div class="phone__screen">
      <slot />
    </div>
  </div>
</div>

<style>
  .phone {
    container-type: inline-size;
    width: 100%;
  }

  .phone__body {
    padding: 3.5cqi;
    border-radius: 15cqi;
    background: #05041a;
    /* A lighter rim and a soft drop, so the body reads on the page colour */
    box-shadow:
      inset 0 0 0 0.6cqi #2a2766,
      0 4cqi 10cqi rgb(0 0 0 / 0.45);
  }

  .phone__screen {
    aspect-ratio: 390 / 844;
    overflow: hidden;
    /* The body's radius minus the bezel, so the curves stay parallel */
    border-radius: 11.5cqi;
    background: var(--tab-page);
  }

  .phone__screen :global(picture),
  .phone__screen :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
