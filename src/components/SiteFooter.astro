---
// The footer: the JAGR thread again (decision 3), in the strip's look. Back to
// the quest on JAGR, the privacy line, and the credits.
import { strings, type Locale } from "../i18n";
import { pagePath } from "../seo";
import { JAGR_QUEST_URL } from "../site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = strings(locale);
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <a class="site-footer__back" href={JAGR_QUEST_URL} rel="noopener noreferrer">
      <span class="site-footer__caret" aria-hidden="true"></span>
      <span>{t.footer.back}</span>
      <svg
        class="site-footer__draw"
        viewBox="0 0 100 8"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path d="M2 5 C 20 1, 30 8, 50 4 S 80 2, 98 5" pathLength="1" fill="none" />
      </svg>
    </a>
    <p class="site-footer__privacy">{t.footer.privacy}</p>
    <a class="site-footer__credits" href={pagePath(locale, "credits")}>
      {t.footer.credits}
    </a>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--jagr-void);
    color: var(--jagr-fg);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1) var(--space-6);
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-3) var(--gutter);
  }

  .site-footer__back,
  .site-footer__credits {
    display: inline-flex;
    align-items: center;
    /* In em, off the spacing scale: the caret's gap follows the text */
    gap: 0.5em;
    min-height: var(--tap-min);
    color: var(--jagr-fg);
    text-decoration: none;
  }

  .site-footer__back {
    position: relative;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }

  .site-footer__back:hover,
  .site-footer__credits:hover {
    color: var(--jagr-red);
  }

  .site-footer__credits {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .site-footer__back:focus-visible,
  .site-footer__credits:focus-visible {
    outline-color: var(--jagr-fg);
  }

  /* JAGR's caret, pointing back, as in the strip */
  .site-footer__caret {
    display: inline-block;
    width: 0.55em;
    height: 0.62em;
    background: var(--jagr-red);
    clip-path: polygon(100% 0, 0 50%, 100% 100%);
  }

  .site-footer__privacy {
    margin: 0;
    text-wrap: pretty;
    color: var(--jagr-fg-dim);
  }

  /* A hand-drawn underline that draws itself on hover and focus */
  .site-footer__draw {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 6px;
    width: 100%;
    height: 8px;
    overflow: visible;
    pointer-events: none;
  }

  .site-footer__draw path {
    stroke: var(--jagr-red);
    stroke-width: 2.5;
    stroke-linecap: round;
    /* A gap longer than the round cap, so no dot is left at rest */
    stroke-dasharray: 1 2;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset var(--dur-xl) var(--ease-out);
  }

  .site-footer__back:hover .site-footer__draw path,
  .site-footer__back:focus-visible .site-footer__draw path {
    stroke-dashoffset: 0;
  }

  /* On a phone: one column, in reading order, as the mock shows */
  @media (max-width: 639px) {
    .site-footer__inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
