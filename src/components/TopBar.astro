---
// The top bar under the JAGR strip: the wordmark and the language links.
import LanguageLinks from "./LanguageLinks.astro";
import Wordmark from "./Wordmark.astro";
import type { Locale } from "../i18n";
import { pagePath, type Page } from "../seo";

interface Props {
  locale: Locale;
  page?: Page;
}

const { locale, page = "home" } = Astro.props;
---

<header class="top-bar">
  <a class="top-bar__home" href={pagePath(locale)}>
    <Wordmark class="top-bar__mark" />
  </a>
  <LanguageLinks locale={locale} page={page} />
</header>

<style>
  .top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-3-5) var(--gutter) 0;
  }

  .top-bar__home {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    border-radius: 10px;
  }

  .top-bar :global(.top-bar__mark) {
    height: 1.5rem;
  }
</style>
