---
// The language page's head tags: title, description, canonical, hreflang, link
// cards. Every URL comes from src/seo.ts, so it's built from one SITE_URL.
// No JSON-LD: search engines read it only inline, and the CSP allows no inline
// script.
import { strings, type Locale } from "../i18n";
import { alternates, OG_IMAGE_SIZE, OG_LOCALE, ogImage, pageUrl } from "../seo";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = strings(locale);
const url = pageUrl(locale);
const image = ogImage(locale);
const otherLocales = Object.entries(OG_LOCALE).filter(([l]) => l !== locale);
---

<title>{t.meta.title}</title>
<meta name="description" content={t.meta.description} />
<link rel="canonical" href={url} />
{alternates().map((a) => (
  <link rel="alternate" hreflang={a.hreflang} href={a.href} />
))}

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Tab" />
<meta property="og:url" content={url} />
<meta property="og:title" content={t.meta.title} />
<meta property="og:description" content={t.meta.description} />
<meta property="og:locale" content={OG_LOCALE[locale]} />
{otherLocales.map(([, value]) => (
  <meta property="og:locale:alternate" content={value} />
))}
<meta property="og:image" content={image} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content={String(OG_IMAGE_SIZE.width)} />
<meta property="og:image:height" content={String(OG_IMAGE_SIZE.height)} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={t.meta.title} />
<meta name="twitter:description" content={t.meta.description} />
<meta name="twitter:image" content={image} />
