---
// /en/credits/ and /es/credits/: the font licences (the OFL asks for its
// notice to travel with the fonts) and who owns the brand and the screens.
import type { GetStaticPaths } from "astro";
import Base from "../../../layouts/Base.astro";
import TopBar from "../../../components/TopBar.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import { LOCALES, strings, type Locale } from "../../../i18n";
import { pagePath } from "../../../seo";

export const getStaticPaths = (() =>
  LOCALES.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const locale = Astro.params.lang as Locale;
const t = strings(locale);
---

<Base locale={locale} page="credits">
  <TopBar locale={locale} page="credits" />
  <main id="main" tabindex="-1" class="credits container">
    <h1 class="credits__title">{t.credits.title}</h1>

    <section aria-labelledby="fonts-title">
      <h2 id="fonts-title" class="credits__heading">
        {t.credits.fontsHeading}
      </h2>
      <p>{t.credits.fontsBody}</p>
      <ul class="credits__links">
        <li>
          <a href="/licenses/poppins-OFL.txt">{t.credits.poppinsLicence}</a>
        </li>
        <li>
          <a href="/licenses/share-tech-mono-OFL.txt">{t.credits.shareTechLicence}</a>
        </li>
      </ul>
    </section>

    <section aria-labelledby="brand-title">
      <h2 id="brand-title" class="credits__heading">
        {t.credits.brandHeading}
      </h2>
      <p>{t.credits.brandBody}</p>
    </section>

    <p>
      <a class="credits__back" href={pagePath(locale)}>
        {t.credits.back}
      </a>
    </p>
  </main>
  <SiteFooter locale={locale} />
</Base>

<style>
  main:focus {
    outline: none;
  }

  .credits {
    max-width: 44rem;
    padding-block: var(--space-page-start) var(--space-page-end);
  }

  .credits__title {
    margin: 0 0 var(--space-6);
    font-size: var(--text-page-title);
    line-height: 1.15;
  }

  .credits__heading {
    margin: var(--space-8) 0 var(--space-2);
    font-size: var(--text-xl);
  }

  .credits p {
    margin: 0;
    color: var(--muted);
  }

  .credits a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    color: var(--ink);
    text-underline-offset: 0.2em;
  }

  .credits__links {
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }

  .credits__back {
    margin-top: var(--space-8);
  }
</style>
