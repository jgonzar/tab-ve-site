---
// The landing page, once per language: /en/ and /es/. Structure A from the
// plan (decision 4): the hero, three features with screens, how it's built,
// the demo again, then the JAGR footer. Every string is the approved copy.
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import TopBar from "../../components/TopBar.astro";
import ScreenPicture from "../../components/ScreenPicture.astro";
import ReceiptPhone from "../../components/ReceiptPhone.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { LOCALES, strings, type Locale } from "../../i18n";
import type { Screen } from "../../captures";
import { demoUrl } from "../../seo";

export const getStaticPaths = (() =>
  LOCALES.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const locale = Astro.params.lang as Locale;
const t = strings(locale);
const demo = demoUrl(locale);

// The screens shown beside the features, in order; "Settle up" is the receipt
const featureScreens: (Screen | "receipt")[] = ["quick-ride", "summary", "receipt"];
const features = t.features.items.map((item, i) => ({ ...item, screen: featureScreens[i] }));
---

<Base locale={locale}>
  <TopBar locale={locale} />
  <main id="main" tabindex="-1">
    <section class="hero container" aria-labelledby="hero-title">
      <div class="hero__copy">
        <p class="eyebrow">{t.hero.eyebrow}</p>
        <h1 id="hero-title" class="hero__title">
          {t.hero.headline}
        </h1>
        <p class="hero__before">{t.hero.before}</p>
        <p class="hero__sub">{t.hero.sub}</p>
        <a class="btn-primary hero__cta" href={demo} rel="noopener noreferrer">
          {t.demo.cta}
        </a>
      </div>
      <div class="hero__phone">
        <ScreenPicture
          locale={locale}
          name="inicio"
          alt={t.hero.alt}
          width={300}
          sizes="(min-width: 960px) 300px, 240px"
          priority
        />
      </div>
    </section>

    <section class="features container" aria-labelledby="features-title">
      <p class="eyebrow">{t.features.eyebrow}</p>
      <h2 id="features-title" class="section-title">
        {t.features.title}
      </h2>
      <ol class="features__list">
        {features.map((f) => (
          <li class="feature">
            <div class="feature__copy">
              <h3 class="feature__title">{f.title}</h3>
              <p class="feature__body">{f.body}</p>
            </div>
            <div class="feature__phone">
              {f.screen === "receipt" ? (
                <ReceiptPhone locale={locale} caption={f.alt} />
              ) : (
                <ScreenPicture
                  locale={locale}
                  name={f.screen}
                  alt={f.alt}
                  width={260}
                  sizes="(min-width: 720px) 260px, 220px"
                />
              )}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="built container" aria-labelledby="built-title">
      <div class="built__surface">
        <p class="eyebrow">{t.built.eyebrow}</p>
        <h2 id="built-title" class="section-title">
          {t.built.title}
        </h2>
        <ul class="built__chips">
          {t.built.chips.map((chip) => (
            <li class="chip">{chip}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class="closing container">
      <a class="btn-primary" href={demo} rel="noopener noreferrer">
        {t.demo.cta}
      </a>
      <p class="closing__note">{t.demo.note}</p>
    </section>
  </main>
  <SiteFooter locale={locale} />
</Base>

<style>
  main:focus {
    outline: none;
  }

  .section-title {
    margin: 0.25rem 0 0;
    font-size: clamp(1.5rem, 4.5vw, 2rem);
    line-height: 1.25;
  }

  /* Hero: centred on a phone, text beside the phone from 960px */
  .hero {
    display: grid;
    gap: 2.5rem;
    padding-top: clamp(2rem, 6vw, 4.5rem);
    text-align: center;
  }

  .hero__copy {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
  }

  .hero__title {
    margin: 0;
    max-width: 18ch;
    font-size: clamp(2rem, 8vw, 3.25rem);
    line-height: 1.12;
    letter-spacing: -0.01em;
  }

  .hero__before {
    margin: 0.25rem 0 0;
    max-width: 36rem;
    color: var(--tab-text);
    font-size: 1.125rem;
  }

  .hero__sub {
    margin: 0;
    max-width: 36rem;
    color: var(--tab-text-muted);
  }

  .hero__cta {
    margin-top: 0.75rem;
  }

  .hero__phone {
    justify-self: center;
    width: 240px;
  }

  /* One slow float, only for those who haven't asked for less motion */
  @media (prefers-reduced-motion: no-preference) {
    .hero__phone {
      animation: float 4s ease-in-out infinite alternate;
    }
  }

  @keyframes float {
    from {
      transform: translateY(0);
    }

    to {
      transform: translateY(-10px);
    }
  }

  @media (min-width: 960px) {
    .hero {
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 4rem;
      text-align: left;
    }

    .hero__copy {
      justify-items: start;
    }

    .hero__phone {
      width: 300px;
    }
  }

  /* Features: stacked on a phone, side by side and alternating from 720px */
  .features {
    margin-top: var(--section-gap);
  }

  .features__list {
    display: grid;
    gap: 3.5rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .feature {
    display: grid;
    justify-items: center;
    gap: 1.5rem;
    text-align: center;
  }

  .feature__copy {
    max-width: 30rem;
  }

  .feature__title {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .feature__body {
    margin: 0.5rem 0 0;
    color: var(--tab-text-muted);
  }

  .feature__phone {
    width: 220px;
  }

  @media (min-width: 720px) {
    /* Each pair stays close: the list is narrower than the page */
    .features__list {
      max-width: 880px;
      margin-inline: auto;
    }

    .feature {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 3rem;
      text-align: left;
    }

    .feature__copy {
      justify-self: start;
    }

    .feature__phone {
      width: 260px;
    }

    .feature:nth-child(even) .feature__copy {
      order: 2;
    }
  }

  /* How it's built: one raised surface, the stack as chips */
  .built {
    margin-top: var(--section-gap);
  }

  .built__surface {
    padding: clamp(1.5rem, 5vw, 2.5rem);
    border-radius: var(--radius-surface);
    background: var(--tab-raised);
  }

  .built__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .chip {
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--tab-border);
    border-radius: 999px;
    font-size: 0.875rem;
  }

  /* The demo again, with the sample-data note */
  .closing {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    margin-block: var(--section-gap);
    text-align: center;
  }

  .closing__note {
    margin: 0;
    max-width: 30rem;
    color: var(--tab-text-muted);
    font-size: 0.875rem;
  }
</style>
