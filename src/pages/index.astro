---
// Placeholder, so a preview renders while the real page is built. The language
// routes (/en, /es) and the redirect from / arrive in L2, the sections in L4.
import Base from "../layouts/Base.astro";
import Wordmark from "../components/Wordmark.astro";
---

<Base lang="en" title="Tab" description="Tab's landing page, in progress.">
  <main class="placeholder">
    <Wordmark class="placeholder__mark" />
    <p class="placeholder__note">This page is being built.</p>
  </main>
</Base>

<style>
  .placeholder {
    display: grid;
    place-items: center;
    align-content: center;
    gap: 1.5rem;
    min-height: calc(100dvh - var(--tap-min));
    padding: 2rem 1rem;
  }

  .placeholder :global(.placeholder__mark) {
    height: 4rem;
  }

  .placeholder__note {
    margin: 0;
    color: var(--tab-text-muted);
    font-weight: 400;
  }
</style>
