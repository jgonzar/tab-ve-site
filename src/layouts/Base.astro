---
// The one page shell. Everything it loads is same-origin and external: no
// inline <script> or <style> (CSP: script-src 'self'; style-src 'self', and
// build.inlineStylesheets is 'never').
import "../styles/global.css";
import poppins400 from "@fontsource/poppins/files/poppins-latin-400-normal.woff2?url";
import poppins700 from "@fontsource/poppins/files/poppins-latin-700-normal.woff2?url";
import introScript from "../scripts/intro.js?url";
import JagrStrip from "../components/JagrStrip.astro";
import Loader from "../components/Loader.astro";
import SeoHead from "../components/SeoHead.astro";
import { strings, type Locale } from "../i18n";
import type { Page } from "../seo";
import { JAGR_QUEST_URL } from "../site";

interface Props {
  locale: Locale;
  page?: Page;
  /** The entry loader, first in the body: the landing page only */
  intro?: boolean;
}

const { locale, page = "home", intro = false } = Astro.props;
const t = strings(locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Flags the first visit of a session on <html> before the first paint, so
         the entry loader is shown only then. A plain blocking script, not a
         module: a module would run after the first frame. External, for the CSP.
         Only where the loader lives: a visit to another page uses up nothing -->
    {intro && <script is:inline src={introScript} />}
    <SeoHead locale={locale} page={page} />
    <meta name="color-scheme" content="light" />
    <!-- The browser bar matches the JAGR strip at the top -->
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/icons/favicon-48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/icon-180.png" />
    <!-- Both weights early: the headline is 700, and where the size-adjusted
         Arial fallback isn't installed (Linux, most Android) a late swap moves
         the hero -->
    <link rel="preload" href={poppins400} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={poppins700} as="font" type="font/woff2" crossorigin="anonymous" />
  </head>
  <body id="top">
    {intro && <Loader />}
    <a class="skip-link" href="#main">
      {t.skip}
    </a>
    <JagrStrip lang={locale} href={JAGR_QUEST_URL} />
    <slot />
  </body>
</html>
